    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.telegram.org/bot' + $env.TELEGRAM_BOT_TOKEN + '/sendPhoto' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"={{ $env.TELEGRAM_CHAT_ID }}\",\n  \"photo\": \"={{ $('Format photo finalists').item.json.approved_photo_url }}\",\n  \"caption\": \"🎨 *[THÔNG BÁO THIẾT KẾ ĐÃ SẴN SÀNG]*\\n\\n📌 *Content ID:* `\" + $('Adapter: Notion → content-design artifact').item.json.content_id + \"`\\n📝 *Caption Preview:* \" + $('Adapter: Notion → content-design artifact').item.json.caption.slice(0, 100) + \"...\\n\\n👉 *Trang vui lòng bấm nút bên dưới để duyệt đăng ngay mà không cần mở Notion:*\",\n  \"parse_mode\": \"Markdown\",\n  \"reply_markup\": {\n    \"inline_keyboard\": [\n      [\n        {\n          \"text\": \"✅ DUYỆT & ĐĂNG INSTAGRAM NGAY\",\n          \"url\": \"={{ $env.N8N_BASE_URL || 'http://localhost:5678' }}/webhook/gate1-approval?action=approve&page_id=\" + $('Adapter: Notion → content-design artifact').item.json.notion_page_id\n        }\n      ],\n      [\n        {\n          \"text\": \"⚠️ YÊU CẦU CHỈNH SỬA\",\n          \"url\": \"={{ $env.N8N_BASE_URL || 'http://localhost:5678' }}/webhook/gate1-approval?action=reject&page_id=\" + $('Adapter: Notion → content-design artifact').item.json.notion_page_id\n        }\n      ]\n    ]\n  }\n}"
      },
      "id": "telegram-notify-approval",
      "name": "Telegram: Gửi Ảnh & Nút Duyệt 1-Click",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2360, 400],
      "notes": "Gửi ảnh render + Nút duyệt Inline trực tiếp về Telegram cho Trang"
