      "id": "trigger-daily-6am",
      "name": "Trigger: Daily 6:00 AM (Schedule)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [180, 320],
      "notes": "Tự động quét hàng ngày vào lúc 06:00 sáng"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ig-distribution-trigger",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "trigger-on-demand",
      "name": "Trigger: On-Demand Webhook (Trang Request)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 480],
      "webhookId": "ig-distribution-trigger",
      "notes": "Kích hoạt tức thì theo yêu cầu của Trang từ Web App hoặc API"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/databases/87576ad4-b2eb-43e1-a295-3bf84733be16/query",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2022-06-28"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"filter\": {\n    \"and\": [\n      { \"property\": \"Status\", \"status\": { \"equals\": \"Copy ready\" } },\n      { \"property\": \"Format\", \"select\": { \"equals\": \"Static\" } },\n      { \"property\": \"Design approval\", \"select\": { \"does_not_equal\": \"Approved\" } }\n    ]\n  },\n  \"page_size\": 5\n}"
      },
      "id": "notion-query",
      "name": "Notion: Query Content Production DB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 400],
      "credentials": {
        "httpHeaderAuth": {
          "id": "NOTION_TOKEN",
          "name": "Notion Integration Token"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "results",
        "options": {}
      },
      "id": "split-pages",
      "name": "Split into pages",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 3.4,
      "position": [680, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.notion.com/v1/blocks/' + $json.id + '/children?page_size=100' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2022-06-28"
            }
          ]
        }
      },
      "id": "notion-blocks",
      "name": "Fetch page blocks (visual spec)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 400],
      "credentials": {
        "httpHeaderAuth": {
          "id": "NOTION_TOKEN",
          "name": "Notion Integration Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extract metadata from Notion page\nconst page = $('Split into pages').item.json;\nconst blocks = $json.results;\nconst props = page.properties;\n\nfunction txt(p) {\n  if (!p) return '';\n  if (p.type === 'title') return (p.title || []).map(t => t.plain_text).join('');\n  if (p.type === 'select') return p.select ? p.select.name : '';\n  if (p.type === 'rich_text') return (p.rich_text || []).map(t => t.plain_text).join('');\n  return '';\n}\n\nlet keywords = ['window', 'curtain', 'morning light', 'minimal'];\nconst visualBlock = blocks.find(b => b.type === 'paragraph' &&\n  (b.paragraph.rich_text[0]?.plain_text || '').toLowerCase().includes('visual'));\nif (visualBlock) {\n  const vis = visualBlock.paragraph.rich_text.map(t => t.plain_text).join('');\n  if (vis.includes('window')) keywords.push('window');\n  if (vis.includes('curtain')) keywords.push('curtain');\n  if (vis.includes('light')) keywords.push('soft light');\n}\n\nconst captionBlock = blocks.find(b => b.type === 'paragraph' &&\n  (b.paragraph.rich_text[0]?.plain_text || '').toLowerCase().includes('caption'));\nconst caption = captionBlock ? captionBlock.paragraph.rich_text.map(t => t.plain_text).join('') : txt(props['Topic Angle']) || 'Content by Trang Nguyen';\n\nconst artifact = {\n  project_id: txt(props['Content ID']).replace(/[^A-Z0-9-]/g, '') || 'UNKNOWN',\n  content_id: txt(props['Content ID']),\n  content_type: 'STATIC',\n  source_mode: 'NOTION_CONTENT_PRODUCTION',\n  notion_page_id: page.id,\n  caption: caption,\n  unsplash_keywords: keywords,\n  status: txt(props['Status'])\n};\n\nreturn [{ json: artifact }];"
      },
      "id": "adapter",
      "name": "Adapter: Notion → content-design artifact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1160, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.unsplash.com/search/photos?query=' + $json.unsplash_keywords.join(' ') + '&per_page=10&orientation=portrait' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Client-ID ' + $env.UNSPLASH_ACCESS_KEY }}"
            }
          ]
        }
      },
      "id": "unsplash-search",
      "name": "Unsplash: Search photos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1400, 400],
      "notes": "Search Unsplash for real editorial photos matching keywords"
    },
    {
      "parameters": {
        "jsCode": "const adapter = $('Adapter: Notion → content-design artifact').item.json;\nconst photos = $json.results || [];\n\nconst finalists = photos.slice(0, 5).map((p, i) => ({\n  id: p.id,\n  url: p.urls.raw + '?w=1080&h=1350&fit=crop&q=85',\n  photographer: p.user.name,\n  status: i === 0 ? 'approved' : 'candidate',\n  thumbnail: p.urls.thumb\n}));\n\nconst defaultApproved = finalists.length > 0 ? finalists[0].url : 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=1080&h=1350&fit=crop&q=85';\n\nreturn [{\n  json: {\n    ...adapter,\n    unsplash_finalists: finalists,\n    approved_photo_url: defaultApproved\n  }\n}];"
      },
      "id": "format-finalists",
      "name": "Format photo finalists",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1640, 400]
    },
    {
      "parameters": {
        "command": "={{ 'cd \"D:/TRANG/Knowledge Hub/Antigravity/Antigravity Test/hocvien_k1_aiautomation/07-ai-video/build/pilot-free/render\" && node render-png.js --bg \"' + $json.approved_photo_url + '\" --out \"' + $json.content_id + '.png\"' }}"
      },
      "id": "render-png",
      "name": "Render: Typography + Photo → PNG",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1880, 400],
      "notes": "Puppeteer renders HTML with real photo background"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'https://api.notion.com/v1/pages/' + $('Adapter: Notion → content-design artifact').item.json.notion_page_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2022-06-28"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"properties\": {\n    \"Design approval\": { \"select\": { \"name\": \"Pending\" } }\n  }\n}"
      },
      "id": "gate1-set-pending",
      "name": "GATE 1: Set Design approval = Pending",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2120, 400],
      "credentials": {
        "httpHeaderAuth": {
          "id": "NOTION_TOKEN",
          "name": "Notion Integration Token"
        }
