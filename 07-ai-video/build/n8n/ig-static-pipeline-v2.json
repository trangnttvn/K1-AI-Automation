        "jsonBody": "={\n  \"chat_id\": \"={{ $env.TELEGRAM_CHAT_ID }}\",\n  \"text\": \"🎉 *[ĐÃ ĐĂNG INSTAGRAM THÀNH CÔNG]*\\n\\n📌 *Content ID:* `\" + $('Adapter: Notion → content-design artifact').item.json.content_id + \"`\\n🚀 *Meta Post ID:* `\" + $json.id + \"`\\n\\nBài viết đã chính thức lên sóng trên Instagram Business Feed của Trang!\",\n  \"parse_mode\": \"Markdown\"\n}"
      },
      "id": "telegram-notify-published",
      "name": "Telegram: Báo Đăng Thành Công",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [4040, 320]
    }
