        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"anthropic/claude-3.5-sonnet\", max_tokens: 2000, response_format: { \"type\": \"json_object\" }, messages: [ { \"role\": \"system\", \"content\": \"You are an elite Marketing Strategist specializing in Newsjacking & Evergreen content for Trang Nguyen (All-in-One Business Partner for Coaches & Healers).\\n\\nBridge psychology/trending news with coach operational friction (CRM, funnels, email sequences, SOPs, scheduling, onboarding).\\n\\nReturn JSON:\\n{\\n  \\\"insight_title\\\": \\\"Title (max 15 words)\\\",\\n  \\\"pain_decoded\\\": \\\"Psychological mechanism behind pain\\\",\\n  \\\"news_decoded\\\": \\\"Core trend insight\\\",\\n  \\\"bridge\\\": \\\"Aha moment connection to Trang's service\\\",\\n  \\\"content_anchor\\\": \\\"Social post hook\\\",\\n  \\\"hook_options\\\": [\\\"Hook 1\\\", \\\"Hook 2\\\"],\\n  \\\"service_link\\\": \\\"CRM setup|email sequences|funnel builds|SOP documentation|scheduling|client onboarding\\\"\\n}\" }, { \"role\": \"user\", \"content\": JSON.stringify($json) } ] }) }}"
      },
      "id": "e6f49c5e-85b4-4d87-9c60-123456789005",
      "name": "Newsjacking AI Agent (OpenRouter)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1540,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "let ai;\ntry {\n  ai = JSON.parse($json.choices[0].message.content);\n} catch (e) {\n  throw new Error('AI khong tra ve JSON hop le: ' + $json.choices[0].message.content);\n}\n\nconst capRichText = (s) => { const t = String(s || ''); return t.length > 2000 ? t.slice(0, 1997) + '...' : t; };\nconst rawSignal = capRichText(String($('Phân luồng (#trend?)').item.json.signal_text || '').replace(/#(trend|news)/gi, '').trim());\n\nconst SECTIONS = [\n  ['🧠 Pain Decoded', ai.pain_decoded],\n  ['📰 News Decoded', ai.news_decoded],\n  ['🌉 The Bridge', ai.bridge],\n  ['🪝 Hook Options', Array.isArray(ai.hook_options) ? ai.hook_options.map(h => '- ' + h).join('\\n') : String(ai.hook_options || '')],\n  ['🔗 Service Link', ai.service_link]\n];\nconst rt = (s) => ({ type: 'text', text: { content: s } });\nconst chunk = (s) => { const out = []; let t = String(s || ''); if (!t) return ['(trong)']; while (t.length) { out.push(t.slice(0, 1900)); t = t.slice(1900); } return out; };\nconst body_blocks = [];\nfor (const [heading, content] of SECTIONS) {\n  body_blocks.push({ object: 'block', type: 'heading_3', heading_3: { rich_text: [rt(heading)] } });\n  for (const piece of chunk(content)) {\n    body_blocks.push({ object: 'block', type: 'paragraph', paragraph: { rich_text: [rt(piece)] } });\n  }\n}\n\nconst insightJson = JSON.stringify({\n  bridge: ai.bridge,\n  news: ai.news_decoded,\n  hooks: Array.isArray(ai.hook_options) ? ai.hook_options : [String(ai.hook_options || '')],\n  service: ai.service_link\n});\nconst insightJsonSafe = insightJson.length > 1900 ? insightJson.slice(0, 1897) + '...' : insightJson;\n\nreturn [{ json: {\n  insight_title: capRichText(ai.insight_title),\n  content_anchor: capRichText(ai.content_anchor),\n  raw_signal: rawSignal,\n  body_blocks: body_blocks,\n  insight_json: insightJsonSafe,\n  service_link: ai.service_link,\n  captured_at: new Date().toISOString()\n} }];"
      },
      "id": "e6f49c5e-85b4-4d87-9c60-123456789005b",
