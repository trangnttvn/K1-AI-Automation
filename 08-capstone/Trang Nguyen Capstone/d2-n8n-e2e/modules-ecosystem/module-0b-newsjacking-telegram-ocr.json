        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"google/gemini-2.5-flash\", max_tokens: 1000, messages: [ { role: \"system\", content: \"You are an OCR engine reading screenshots sent by a business owner in the coaching/healing industry. Transcribe text and summarize core pain point.\" }, { role: \"user\", content: [ { type: \"text\", text: \"Caption: \" + ($('Telegram Trigger').item.json.message.caption || '') }, { type: \"image_url\", image_url: { url: \"data:image/jpeg;base64,\" + $json.data } } ] } ] }) }}"
      },
      "id": "e6f49c5e-85b4-4d87-9c60-123456789012",
      "name": "OCR Vision (Gemini Flash)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        660,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const caption = $('Telegram Trigger').item.json.message.caption || '';\nlet vision = $json.choices[0].message.content || '';\nconst parts = [];\nif (caption.trim()) parts.push('Caption: ' + caption.trim());\nparts.push('Noi dung doc tu anh: ' + vision.trim());\nreturn [{ json: { signal_text: parts.join('\\n\\n'), source_kind: 'image' } }];"
      },
      "id": "e6f49c5e-85b4-4d87-9c60-123456789013",
      "name": "Chuẩn hóa (ảnh)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const msg = $json.message || {};\nconst text = msg.text || msg.caption || '';\nreturn [{ json: { signal_text: text.trim(), source_kind: 'text' } }];"
      },
      "id": "e6f49c5e-85b4-4d87-9c60-123456789014",
      "name": "Chuẩn hóa (text)",
