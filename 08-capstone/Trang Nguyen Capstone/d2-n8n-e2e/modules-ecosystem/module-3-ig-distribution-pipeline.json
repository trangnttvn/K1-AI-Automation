            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Design approved": {
      "main": [
        [
          {
            "node": "IG: Create media container",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "IG: Create media container": {
      "main": [
        [
          {
            "node": "IG: Publish media",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IG: Publish media": {
      "main": [
        [
          {
            "node": "Notion: Mark Posted + save Post ID",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "description": "IG Static Pipeline v2.0 — Real photo from Unsplash + programmatic typography. No AI image generation.",
    "version": "2.0.0"
  }
}